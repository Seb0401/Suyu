# Copia este archivo a .env.local y llena lo que tengas.
# NADA de esto es obligatorio: la app funciona completa sin ninguna key
# (CLAUDE.md §2.1). Con keys, mejora.

# --- Servidor: nunca se exponen al cliente ---

# Copiloto con IA real. Sin esta key el chat responde por reglas y lo dice.
ANTHROPIC_API_KEY=

# Cliente administrador de Supabase. Requerido para el Pasaporte Arequipeño
# (check-in, fotos): es el primer endpoint que lo usa. El resto de la app
# sigue sin necesitarlo.
SUPABASE_SERVICE_ROLE_KEY=

# Ruta peatonal real via OpenRouteService (openrouteservice.org, alta gratuita).
# Con accessible=true usa el perfil `wheelchair`, que rutea sobre veredas,
# bordillos e inclinacion de OSM. Sin esta key la ruta es linea recta marcada
# como aproximada. Server-only: solo la lee /api/route-finder.
ORS_API_KEY=

# --- Cliente: el prefijo NEXT_PUBLIC_ es obligatorio ---

# Sin Supabase, los datos salen de data/*.json. El Pasaporte Arequipeño
# (cuentas, estampas, fotos) SI necesita esto configurado — es la unica
# funcion, junto con el copiloto y los reportes, que requiere conexion real.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (El mapa no lleva ninguna variable: MapLibre GL JS + OpenFreeMap sirven los
# tiles sin cuenta, sin API key y sin limite de peticiones.)
