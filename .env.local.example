# Copia este archivo a .env.local y llena lo que tengas.
# NADA de esto es obligatorio: la app funciona completa sin ninguna key
# (CLAUDE.md §2.1). Con keys, mejora.

# --- Servidor: nunca se exponen al cliente ---

# Copiloto con IA real. Sin esta key el chat responde por reglas y lo dice.
ANTHROPIC_API_KEY=

# Cliente administrador de Supabase. Reservado para uso server-only futuro.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cliente: el prefijo NEXT_PUBLIC_ es obligatorio ---

# Sin Supabase, los datos salen de data/*.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sin token de Mapbox, el mapa muestra un aviso y la ruta es linea recta
# marcada como aproximada.
NEXT_PUBLIC_MAPBOX_TOKEN=
